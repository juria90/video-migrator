__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
# NOTE: uv.lock is deliberately NOT ignored - commit it for reproducible installs.

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Linting
.ruff_cache/

# Cache
.cache/
*.log

# Config (contains secrets)
config/client_secrets.json
.env

# OS
.DS_Store
Thumbs.db

# Project-specific
*.mp4
*.avi
*.mov
*.mkv

# Scrape output - regenerable, keep it out of history
*.csv

# config/ and data/ describe the real site and the real people on it: profiles,
# credentials, scrape output, and working notes taken from it. Ignore both
# wholesale rather than by extension — the rule has to hold for the next file
# type someone reaches for, not just the ones used so far. The publishable
# example profiles live in src/video_migrator/profiles/ instead.
config/*
data/*
